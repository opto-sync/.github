---
const features=[
 ["Optimistic local writes","Persist the application row and mutation intent locally, render immediately, then let a bounded protocol cycle settle remote truth."],
 ["One merge engine","TypeScript, Dart, Rust, and Gleam all call the pinned `syncer.c` core instead of reimplementing reconciliation."],
 ["Durable protocol queues","Mutation IDs, client identity, dedupe, pull checkpoints, accepted/rejected overlays, and tombstones survive restart."],
 ["Explicit write strategy","Choose remote-confirmed, local-durable, or local-then-remote behavior per operation rather than hiding latency semantics."],
 ["Hints are not commits","WebSocket, Supabase Realtime, BroadcastChannel, and TCP wake clients; HTTP push/pull preserves commit order."],
 ["Proof-backed lifecycle","Quint/TLC, Kani, CBMC, trace replay, native bindings, browser tests, and live Postgres profiles cover the same contract."],
];
const samples=[
 {id:"ts",label:"TypeScript",file:"todo.ts",code:`import 'fake-indexeddb/auto';
import { OptoSyncClient, SYNC_STATUS } from '@opto-sync/client';

const client = new OptoSyncClient({ databaseName: 'demo' });
const mutationId = await client.queueMutation('todos', 'todo-1', {
  id: 'todo-1',
  title: 'buy milk',
  updatedAt: '2026-07-24T12:00:00Z',
});

// POST the durable queue through your transport, then acknowledge.
await client.markMutation(mutationId, SYNC_STATUS.SYNCED);`,note:"Verified public TypeScript surface. In a browser, initialize the WASM engine and use real IndexedDB."},
 {id:"dart",label:"Dart / Flutter",file:"todo.dart",code:`final syncer = FfiSyncer(
  libraryPath: resolveSyncerLibraryPath(
    directory: '../../../syncer.c/core/build',
  ),
);
final db = OptoSyncDatabase(NativeDatabase(File('queue.sqlite')));
final client = OptoSyncClient(db: db, syncer: syncer);

await client.queueMutation('todos', 'todo-1', {
  'id': 'todo-1',
  'title': 'buy milk',
  'updatedAt': '2026-07-24T12:00:00Z',
});`,note:"Verified Dart client with Drift/SQLite and the same native merge core used by every runtime."},
 {id:"rust",label:"Rust",file:"todo.rs",code:`use opto_sync_client::sqlite::SqliteProtocolStore;

let mut store = SqliteProtocolStore::open(
    "opto-sync.sqlite",
    "stable-install-id",
)?;
store.queue_upsert_record(
    "tasks",
    "todo-1",
    serde_json::json!({"title": "buy milk"}),
    None,
    false,
)?;

let mut queue = store.load_queue()?;
let result = driver.sync_cycle_atomic(&mut queue, &mut transport, &mut store)?;`,note:"The first-party SQLite store atomically commits protocol state, overlays, snapshots, and checkpoints."},
 {id:"gleam",label:"Gleam / BEAM",file:"todo.gleam",code:`import gleam/option.{None}
import opto_sync_client

let assert Ok(queue) = opto_sync_client.new("stable-installation-id")
let assert Ok(#(queue, _)) = opto_sync_client.enqueue_upsert(
  queue,
  "todos",
  "todo-1",
  "{\"title\":\"buy milk\",\"updatedAt\":2}",
  None,
  False,
)
let snapshot = opto_sync_client.encode_queue(queue)`,note:"The typed Gleam queue is persisted by the host and reconciled through the Rustler/NIF binding."},
];
